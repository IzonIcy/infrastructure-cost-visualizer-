{
  "name": "infrastructure-cost-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based dashboard to estimate and explore infrastructure spend. Optional Node backend for scenario persistence.",
  "type": "module",
  "scripts": {
    "dev": "node ./server/index.js",
    "start": "NODE_ENV=production node ./server/index.js",
    "smoke": "node ./server/smoke.js",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "vitest": "^3.0.0"
  }
}
